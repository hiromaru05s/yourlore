{
  "name": "lore-tcg",
  "version": "0.1.0",
  "private": true,
  "description": "LORE \u2014 deckbuild x TCG hybrid. Cloudflare-hosted (Pages + Workers + Durable Objects + D1).",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm --workspace client run dev",
    "build": "node scripts/guard-design.mjs && npm --workspace client run build",
    "guard:design": "node scripts/guard-design.mjs",
    "typecheck": "npm --workspace client run typecheck && npm --workspace server run typecheck",
    "art:check": "node scripts/check-card-art.mjs",
    "art:prompts": "node scripts/export-card-art-prompts.mjs",
    "art:generate": "node scripts/generate-card-art.mjs",
    "server:dev": "npm --workspace server run dev",
    "deploy": "node scripts/deploy-guard.mjs production",
    "deploy:staging": "node scripts/deploy-guard.mjs staging",
    "text:check": "node scripts/check-card-text.mjs",
    "art:thumbs": "node scripts/build-card-thumbs.mjs",
    "test:production": "node scripts/test-production.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.144.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
