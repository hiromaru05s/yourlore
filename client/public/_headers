# static art/media: safe to cache long — filenames change when content changes meaningfully
/art/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/frames/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/bg/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/ui/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/sfx/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/*
  Cache-Control: public, max-age=31536000, immutable
