# Fixed URLs must revalidate; content-hashed assets and font subsets are immutable.
/art/*
  Cache-Control: public, max-age=0, must-revalidate
/frames/*
  Cache-Control: public, max-age=0, must-revalidate
/bg/*
  Cache-Control: public, max-age=0, must-revalidate
/ui/*
  Cache-Control: public, max-age=0, must-revalidate
/icons/*
  Cache-Control: public, max-age=0, must-revalidate
/sfx/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/music/*
  Cache-Control: public, max-age=0, must-revalidate

/fonts/web/files/*
  Cache-Control: public, max-age=31536000, immutable
